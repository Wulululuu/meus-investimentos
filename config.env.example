# Copie este arquivo para "config.env" (mesma pasta) e preencha conforme for
# hospedando o app. Enquanto config.env não existir (ou APP_URL estiver
# vazio), o app roda 100% local, exatamente como sempre rodou.

# Depois de publicar o backend no Render, cole aqui a URL pública dele
# (ex: https://meus-investimentos.onrender.com). Com isso preenchido, a
# janela desktop passa a abrir o servidor hospedado em vez de rodar um
# servidor local — necessário para os dados ficarem sincronizados com o
# celular.
APP_URL=

# Usados pelo update_daily.py para logar sozinho e disparar a atualização
# diária no servidor hospedado (sem isso, a tarefa agendada do Windows não
# funciona depois que o app for pra nuvem). Use o mesmo usuário/senha que
# você criou na primeira vez que abriu o app.
APP_USERNAME=
APP_SENHA=

# --- Só usados quando o BACKEND roda no Render (não no seu PC) ---

# Chave secreta fixa da sessão de login — sem isso, todo mundo é deslogado
# a cada reinício/deploy do servidor. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Credenciais do banco Turso (turso.tech) — é o que permite desktop e
# celular compartilharem os mesmos dados.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
